#!/usr/bin/env bash
# dvm - use a Devin Cloud macOS VM as a remote build/QA machine.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
STATE_DIR="${DVM_STATE_DIR:-$ROOT/.state}"
[[ "$STATE_DIR" != *[[:space:]]* ]] || { echo "dvm: state dir path must not contain spaces: $STATE_DIR" >&2; exit 1; }
CURRENT_FILE="$STATE_DIR/current"
API_BASE="${DEVIN_API_BASE:-https://api.devin.ai}"
HOLD_PROMPT='This session is a remote macOS build/QA machine that another agent drives over SSH. Do not start any work, do not edit files, do not open pull requests, and do not run commands. Reply with the single word "ready" and then wait silently. Later messages are only keep-alive pings: answer each with a single "." and keep waiting.'

die() { echo "dvm: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "'$1' is required but not installed"; }

usage() {
  cat <<'EOF'
dvm - drive a Devin Cloud macOS VM from a local agent session

Session
  dvm up [--repo owner/repo]... [--title T] [--platform macos] [--mode M]
                              create a VM session, make it current, wait for SSH;
                              M is the devin_mode (e.g. swe-2-medium), default the org's
  dvm wake                    keep a swe-2-* session awake about 30 min by sending a
                              "." message (warns and sends nothing for other modes)
  dvm use <session-id|url>    make an existing session current
  dvm current                 print the current session id
  dvm status                  show status, usage, and URL of the current session
  dvm wait [seconds]          wait until SSH to the VM answers (default 600)
  dvm sleep                   archive the session (disk kept, processes stop)
  dvm down                    terminate the session permanently

Work
  dvm run [--cd DIR] -- CMD...  run CMD on the VM (login zsh), exit code is CMD's
  dvm push [LOCAL_DIR] [REMOTE_DIR] [--exclude PATTERN]...
                              rsync a directory to the VM (default ~/work/<name>)
  dvm pull REMOTE_PATH [LOCAL_DEST]
                              rsync files back (default ./dvm-artifacts/)
  dvm forward PORT...         forward VM ports to localhost (foreground)
  dvm shell                   interactive shell on the VM
  dvm doctor                  check CLI, auth, API access, and the current session

Environment
  DEVIN_API_KEY   cog_ token (PAT or service user); falls back to the CLI login
  DEVIN_ORG_ID    organization id; resolved from /v3/self when unset
  DVM_SESSION     override the current session id
EOF
}

# ---------- auth / API ----------

cli_token() {
  local cred="${DEVIN_CREDENTIALS_FILE:-$HOME/.local/share/devin/credentials.toml}"
  [[ -f "$cred" ]] || return 1
  local value
  value="$(sed -nE 's/^[[:space:]]*(windsurf_api_key|api_key|token|access_token)[[:space:]]*=[[:space:]]*"([^"]+)".*/\2/p' "$cred" | head -1)"
  [[ -n "$value" ]] || return 1
  printf '%s' "$value"
}

token() {
  if [[ -n "${DEVIN_API_KEY:-}" ]]; then
    printf '%s' "$DEVIN_API_KEY"
  else
    cli_token || die "no API credential: run 'devin auth login' or set DEVIN_API_KEY"
  fi
}

api() { # METHOD PATH [JSON_BODY]
  local method="$1" path="$2" body="${3:-}" args
  args=(-sS --fail-with-body -X "$method" "$API_BASE$path"
        -H "Authorization: Bearer $(token)" -H "Accept: application/json")
  if [[ -n "$body" ]]; then
    args+=(-H "Content-Type: application/json" --data "$body")
  fi
  curl "${args[@]}" || die "API $method $path failed"
}

org_id() {
  if [[ -n "${DEVIN_ORG_ID:-}" ]]; then
    printf '%s' "$DEVIN_ORG_ID"
    return
  fi
  if [[ -s "$STATE_DIR/org_id" ]]; then
    cat "$STATE_DIR/org_id"
    return
  fi
  local org
  org="$(api GET /v3/self | jq -r '.org_id // empty')"
  [[ -n "$org" ]] || die "could not resolve org id from /v3/self; set DEVIN_ORG_ID"
  mkdir -p "$STATE_DIR"
  printf '%s' "$org" > "$STATE_DIR/org_id"
  printf '%s' "$org"
}

# ---------- session ----------

normalize_id() { # accepts an id or an app.devin.ai session URL
  local raw="${1%/}"
  raw="${raw##*/}"
  printf '%s' "${raw#devin-}"
}

session() {
  if [[ -n "${DVM_SESSION:-}" ]]; then
    normalize_id "$DVM_SESSION"
  elif [[ -s "$CURRENT_FILE" ]]; then
    cat "$CURRENT_FILE"
  else
    die "no current session: run 'dvm up' or 'dvm use <id>'"
  fi
}

set_current() {
  mkdir -p "$STATE_DIR"
  printf '%s' "$1" > "$CURRENT_FILE"
}

cmd_up() {
  local platform="macos" title="dvm remote mac" mode="" repos=() body response sid url
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo) repos+=("$2"); shift 2 ;;
      --mode) mode="$2"; shift 2 ;;
      --title) title="$2"; shift 2 ;;
      --platform) platform="$2"; shift 2 ;;
      *) die "up: unknown argument '$1'" ;;
    esac
  done
  body="$(jq -n --arg prompt "$HOLD_PROMPT" --arg title "$title" --arg platform "$platform" --arg mode "$mode" \
    --args '{prompt: $prompt, title: $title, platform: $platform, tags: ["dvm"]}
            + (if $mode != "" then {devin_mode: $mode} else {} end)
            + (if ($ARGS.positional | length) > 0 then {repos: $ARGS.positional} else {} end)' \
    ${repos[@]+"${repos[@]}"})"
  response="$(api POST "/v3/organizations/$(org_id)/sessions" "$body")"
  sid="$(jq -r '.session_id' <<<"$response")"
  url="$(jq -r '.url' <<<"$response")"
  [[ -n "$sid" && "$sid" != null ]] || die "unexpected create response: $response"
  set_current "$sid"
  echo "session $sid"
  echo "url     $url"
  cmd_wait
}

cmd_use() {
  [[ $# -eq 1 ]] || die "use: expected one session id or URL"
  set_current "$(normalize_id "$1")"
  cat "$CURRENT_FILE"; echo
}

cmd_status() {
  api GET "/v3/organizations/$(org_id)/sessions/$(session)" |
    jq -r '"session  \(.session_id)\nmode     \(.devin_mode // "?")\nstatus   \(.status) \(.status_detail // "")\nusage    \(.acus_consumed)\nurl      \(.url)"'
}

# SSH logins wake a sleeping session only for a few minutes, while an agent message restarts
# its 30-minute idle timer. A "." costs little only in swe-2-* sessions, so other modes are
# left alone.
cmd_wake() {
  local sid org mode
  sid="$(session)"
  org="$(org_id)"
  mode="$(api GET "/v3/organizations/$org/sessions/$sid" | jq -r '.devin_mode // "unknown"')"
  case "$mode" in
    swe-2-*)
      api POST "/v3/organizations/$org/sessions/$sid/messages" '{"message":"."}' >/dev/null
      echo "woke $sid ($mode)" ;;
    *) echo "dvm: wake: $sid is a $mode session; not sending a message (only swe-2-* sessions)" >&2 ;;
  esac
}

cmd_wait() {
  local limit="${1:-600}" sid start
  sid="$(session)"
  start=$SECONDS
  echo "waiting for SSH on $sid (up to ${limit}s)..."
  until open_master "$sid"; do
    (( SECONDS - start < limit )) || die "SSH did not answer within ${limit}s"
    sleep 10
  done
  echo "ready after $((SECONDS - start))s"
}

cmd_sleep() {
  local sid
  sid="$(session)"
  close_master "$sid"
  api POST "/v3/organizations/$(org_id)/sessions/$sid/archive" >/dev/null
  echo "archived $sid"
}

cmd_down() {
  local sid
  sid="$(session)"
  close_master "$sid"
  api DELETE "/v3/organizations/$(org_id)/sessions/$sid" >/dev/null
  rm -f "$CURRENT_FILE"
  echo "terminated $sid"
}

# ---------- remote execution ----------

# A first connection otherwise stops at ssh's interactive host-key prompt.
ensure_host_key() {
  local host="${DVM_SSH_GATEWAY:-ssh.devin.ai}"
  ssh-keygen -F "$host" >/dev/null 2>&1 && return
  mkdir -p "$HOME/.ssh"
  ssh-keyscan -t ed25519 "$host" 2>/dev/null >> "$HOME/.ssh/known_hosts" ||
    die "could not fetch the host key of $host"
  echo "dvm: added $host host key: $(ssh-keygen -lf <(ssh-keyscan -t ed25519 "$host" 2>/dev/null) | awk '{print $2}')" >&2
}

with_timeout() { # SECONDS CMD... (macOS has no timeout(1))
  perl -e 'alarm shift; exec @ARGV or die "exec failed: $!"' "$@"
}

# Transport. The gateway authenticates with a keyboard-interactive code that `devin ssh`
# types into a local PTY; that PTY echoes stdin, rewrites \n to \r\n, and never passes EOF,
# so nothing binary (rsync, tar) survives it. `devin ssh` is therefore used only to
# authenticate: libexec/ssh (put first on PATH) makes that login an OpenSSH ControlMaster,
# and every command and transfer then runs over plain, PTY-free ssh that reuses it.
ssh_host() { printf 'devin-%s@%s' "$1" "${DVM_SSH_GATEWAY:-ssh.devin.ai}"; }
control_path() { printf '%s/cm-%s' "$STATE_DIR" "${1:0:16}"; }
ssh_base() { # SID -> ssh command line (without host) that only reuses the master
  printf '/usr/bin/ssh -o ControlPath=%s -o ControlMaster=no -o BatchMode=yes -T' "$(control_path "$1")"
}

master_alive() {
  /usr/bin/ssh -o "ControlPath=$(control_path "$1")" -O check "$(ssh_host "$1")" >/dev/null 2>&1
}

open_master() { # SID -> 0 once an authenticated master connection exists
  local sid="$1" pty=()
  master_alive "$sid" && return 0
  ensure_host_key
  mkdir -p "$STATE_DIR"
  # `devin ssh` opens /dev/tty for its login and fails with "Device not configured" where
  # there is no terminal (launchd jobs, agent shells); script(1) gives it a pseudo-terminal.
  [[ "$(uname -s)" == Darwin ]] && pty=(/usr/bin/script -q /dev/null)
  PATH="$ROOT/libexec:$PATH" DVM_CONTROL_PATH="$(control_path "$sid")" \
    with_timeout 180 ${pty[@]+"${pty[@]}"} devin ssh "$sid" true </dev/null >/dev/null 2>&1 || return 1
  master_alive "$sid"
}

close_master() {
  master_alive "$1" || return 0
  /usr/bin/ssh -o "ControlPath=$(control_path "$1")" -O exit "$(ssh_host "$1")" >/dev/null 2>&1 || true
}

# Runs CMD over the master. Devin suspends idle sessions even while SSH work is running.
# The local master can then die, or stay alive while the gateway refuses every new session
# on it (ssh exits 255). In either case close the master, log in again (this also wakes the
# session) and retry once. A command that merely fails is not retried.
with_reconnect() { # SID CMD...
  local sid="$1" rc=0
  shift
  open_master "$sid" || die "cannot open an SSH connection to $sid (try 'dvm wait' or 'dvm status')"
  "$@" || rc=$?
  if (( rc == 255 )) || { (( rc != 0 )) && ! master_alive "$sid"; }; then
    echo "dvm: connection to $sid failed (the session probably went to sleep); reconnecting and retrying once" >&2
    close_master "$sid"
    local attempt=1 tries="${DVM_RECONNECT_TRIES:-3}"
    until open_master "$sid"; do
      (( attempt++ < tries )) || die "cannot reconnect to $sid after $tries logins"
      echo "dvm: login to $sid failed while it wakes; trying again in ${DVM_RECONNECT_PAUSE:-15}s" >&2
      sleep "${DVM_RECONNECT_PAUSE:-15}"
    done
    rc=0
    "$@" || rc=$?
  fi
  return "$rc"
}

remote_ssh() { # SID REMOTE_COMMAND...
  local sid="$1"
  shift
  with_reconnect "$sid" $(ssh_base "$sid") "$(ssh_host "$sid")" "$@"
}

remote_cmd() { # DIR CMD... -> single zsh -lc string; one argument is taken as a shell script
  local dir="$1" joined
  shift
  if [[ $# -eq 1 ]]; then
    joined="$1"
  else
    printf -v joined '%q ' "$@"
  fi
  local script="cd $dir && $joined"
  printf 'zsh -lc %q' "$script"
}

cmd_run() {
  local dir='~'
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cd) dir="$2"; shift 2 ;;
      --) shift; break ;;
      *) break ;;
    esac
  done
  [[ $# -gt 0 ]] || die "run: missing command"
  remote_ssh "$(session)" "$(remote_cmd "$dir" "$@")"
}

cmd_push() {
  local local_dir="" remote_dir="" excludes=(node_modules/ .build/ DerivedData/ build/ .DS_Store .state/)
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --exclude) excludes+=("$2"); shift 2 ;;
      *) if [[ -z "$local_dir" ]]; then local_dir="$1"; elif [[ -z "$remote_dir" ]]; then remote_dir="$1"; else die "push: too many arguments"; fi; shift ;;
    esac
  done
  local_dir="$(cd "${local_dir:-.}" && pwd)"
  remote_dir="${remote_dir:-work/$(basename "$local_dir")}"
  local sid pattern
  sid="$(session)"
  remote_ssh "$sid" "mkdir -p $remote_dir"
  local args=(-az --delete -e "$(ssh_base "$sid")")
  for pattern in "${excludes[@]}"; do args+=(--exclude "$pattern"); done
  with_reconnect "$sid" rsync "${args[@]}" "$local_dir/" "$(ssh_host "$sid"):$remote_dir/"
  echo "pushed $local_dir -> ~/$remote_dir"
}

cmd_pull() {
  [[ $# -ge 1 ]] || die "pull: missing REMOTE_PATH"
  local remote="$1" dest="${2:-./dvm-artifacts/}" sid
  sid="$(session)"
  mkdir -p "$dest"
  with_reconnect "$sid" rsync -az -e "$(ssh_base "$sid")" "$(ssh_host "$sid"):$remote" "$dest"
  echo "pulled ~/$remote -> $dest"
}

cmd_forward() {
  [[ $# -ge 1 ]] || die "forward: missing PORT"
  exec devin forward "$(session)" "$@"
}

cmd_shell() { exec devin ssh "$(session)"; }

cmd_doctor() {
  echo "devin    $(devin --version 2>&1 | head -1)"
  devin auth status 2>&1 | sed 's/^/auth     /' | head -2
  if self="$(api GET /v3/self 2>/dev/null)"; then
    echo "api      ok ($(jq -r '.principal_type // "?"' <<<"$self"), org $(jq -r '.org_id // "?"' <<<"$self"))"
  else
    echo "api      FAILED (set DEVIN_API_KEY to a cog_ PAT if the CLI login is not accepted)"
  fi
  if [[ -n "${DVM_SESSION:-}" || -s "$CURRENT_FILE" ]]; then
    cmd_status || true
    if remote_ssh "$(session)" true >/dev/null 2>&1; then echo "ssh      ok"; else echo "ssh      not reachable"; fi
  else
    echo "session  none"
  fi
}

main() {
  need devin; need jq; need curl
  local sub="${1:-help}"
  [[ $# -gt 0 ]] && shift
  case "$sub" in
    up) cmd_up "$@" ;;
    use) cmd_use "$@" ;;
    current) session; echo ;;
    status) cmd_status ;;
    wait) cmd_wait "$@" ;;
    wake) cmd_wake ;;
    sleep) cmd_sleep ;;
    down) cmd_down ;;
    run) cmd_run "$@" ;;
    push) need rsync; cmd_push "$@" ;;
    pull) need rsync; cmd_pull "$@" ;;
    forward) cmd_forward "$@" ;;
    shell) cmd_shell ;;
    doctor) cmd_doctor ;;
    help|-h|--help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
