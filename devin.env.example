# Example configuration for dvm and macrun.
# Copy to ~/.config/mac-offload/devin.env (or set MAC_OFFLOAD_CONFIG to another path) and
# uncomment what you need. macrun sources this file; every value is exported so the dvm that
# macrun starts sees it too. Without this file, the defaults shown here apply.

# --- Devin API (dvm) ---
# export DEVIN_API_KEY=cog_...                  # default: the token from 'devin auth login'
# export DEVIN_ORG_ID=org-...                   # default: looked up once from /v3/self
# export DEVIN_API_BASE=https://api.devin.ai
# export DEVIN_CREDENTIALS_FILE="$HOME/.local/share/devin/credentials.toml"

# --- Session and SSH (dvm) ---
# export DVM_SESSION=...                        # default: the session from 'dvm up' / 'dvm use'
# export DVM_STATE_DIR="$HOME/.local/state/dvm" # default: .state in the devin-vm clone
# export DVM_SSH_GATEWAY=ssh.devin.ai
# export DVM_RECONNECT_TRIES=3
# export DVM_RECONNECT_PAUSE=15
# export DVM_CONTROL_PERSIST=1800

# --- macrun ---
# export DVM="$HOME/devin-vm/bin/dvm"           # default: the dvm next to macrun
# export MACRUN_GIT=1                           # 0: send no git metadata
# export MACRUN_DEVELOPER_DIR=auto              # auto, none, or /Applications/Xcode-X.app/Contents/Developer
# export DVM_WAKE_AFTER=240                     # 0: never send keep-awake messages
# export DVM_WAKE_EVERY=240
# export MACRUN_LOG_DIR="$HOME/Library/Logs/mac-offload/macrun"
# export MACRUN_STATE_DIR="$HOME/.local/state/mac-offload"
# export MACRUN_CACHE_DIR="$HOME/.cache/mac-offload/macrun"
